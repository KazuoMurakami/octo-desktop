{
  "name": "octo",
  "productName": "Octo",
  "version": "0.1.1",
  "private": true,
  "description": "Issues no estilo Linear para o Claude Code: conecte uma pasta com vários repositórios, delegue para o agente e acompanhe tudo, no app ou no seu terminal.",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "ai-agents",
    "linear",
    "issue-tracker",
    "multi-repo",
    "monorepo",
    "electron",
    "developer-tools"
  ],
  "homepage": "https://github.com/KazuoMurakami/octo-desktop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KazuoMurakami/octo-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/KazuoMurakami/octo-desktop/issues"
  },
  "license": "MIT",
  "author": "Octo contributors",
  "type": "module",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --disable-warning=ExperimentalWarning --watch-path=server --watch-path=shared server/index.ts --dev",
    "dev:web": "vite",
    "build": "vite build",
    "start": "npm run build && node --disable-warning=ExperimentalWarning server/index.ts --open",
    "serve": "node --disable-warning=ExperimentalWarning server/index.ts",
    "desktop": "npm run build:desktop && electron .",
    "build:desktop": "node scripts/build-desktop.mjs",
    "dist": "npm run build:desktop && electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^10.0.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.56.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "zustand": "^5.0.8"
  }
}
